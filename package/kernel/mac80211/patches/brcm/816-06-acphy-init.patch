+/*
+ * RX gain-control register block (radio_rev 4, 5 GHz), per active core (0x0720-0x073e). Le read iniziali del trace sono readback fake; qui solo MOD/WR.
+ * 4360 agcombo: TODO ; d6220 ch36: n/l (write per-core ad addr calcolati, <3 op letterali) */
+static void b43_phy_ac_rxgainctrl_regs(struct b43_wldev *dev)
+{
+	/* Offsets into gain table (tbl 0x07) for the rx-lpf stage-0 hi word,
+	 * per core. These encode the LPF config that analog_on_reset wrote;
+	 * reading them makes this function channel-independent. */
+	static const u16 hi_off[3] = { 0x0360, 0x0370, 0x0380 };
+	u8 c, num_cores = dev->phy.ac->num_cores;
+	u8 mask = dev->phy.ac->coremask;
+
+	for (c = 0; c < num_cores; c++) {
+		u16 s = (u16)(c * 0x200);
+		u16 gw_hi;
+
+		if (!((mask >> c) & 1))
+			continue;
+
+		/* Read the rx-lpf gain word hi (9-bit, bits 24:16 of 25-bit word)
+		 * from the gain table. On ch36 this is 0x0154, on ch44 it's
+		 * 0x0152 — the low bits encode the channel-dependent LPF cap. */
+		b43_actab_read_bulk(dev, 7, hi_off[c], 16, 1, &gw_hi);
+
+		b43_phy_write(dev,   0x073e + s, 0x0440);
+		b43_phy_set(dev,     0x0727 + s, 0x0002);
+		b43_phy_maskset(dev, 0x073c + s, (u16)~0x000e, 0x0002);
+		b43_phy_set(dev,     0x0727 + s, 0x0001);
+		b43_phy_set(dev,     0x073c + s, 0x0001);
+		b43_phy_set(dev,     0x0721 + s, 0x0100);
+		b43_phy_mask(dev,    0x0729 + s, (u16)~0x0100);
+		b43_phy_set(dev,     0x0720 + s, 0x0020);
+		b43_phy_set(dev,     0x0728 + s, 0x0020);
+		b43_phy_set(dev,     0x0720 + s, 0x0040);
+		b43_phy_mask(dev,    0x0728 + s, (u16)~0x0040);
+		b43_phy_set(dev,     0x0720 + s, 0x0010);
+		b43_phy_set(dev,     0x0728 + s, 0x0010);
+		b43_phy_write(dev,   0x0736 + s, gw_hi);
+		b43_phy_write(dev,   0x0724 + s, 0x03ff);
+		b43_phy_maskset(dev, 0x073a + s, (u16)~0x0007, 0x0003);
+		b43_phy_set(dev,     0x0725 + s, 0x0020);
+		b43_phy_maskset(dev, 0x0739 + s, (u16)~0x007e, 0x007a);
+		b43_phy_set(dev,     0x0725 + s, 0x0002);
+		b43_phy_mask(dev,    0x073a + s, (u16)~0x0008);
+		b43_phy_set(dev,     0x0725 + s, 0x0040);
+		b43_phy_set(dev,     0x073a + s, 0x0010);
+		b43_phy_set(dev,     0x0725 + s, 0x0080);
+		b43_phy_maskset(dev, 0x073a + s, (u16)~0x0060, 0x0040);
+		b43_phy_set(dev,     0x0725 + s, 0x0100);
+		b43_phy_mask(dev,    0x0734 + s, (u16)~0x0007);
+		b43_phy_set(dev,     0x0722 + s, 0x0004);
+	}
+}
