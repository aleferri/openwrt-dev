+/* 4360 agcombo: 6310-6315 ; d6220 ch36 @#35044-#35049 (BW1A 0x371-0x376) */
+static void b43_phy_ac_channel_setup(struct b43_wldev *dev,
+				     const struct b43_phy_ac_channeltab_e_radio2069 *e,
+				     struct ieee80211_channel *new_channel)
+{
+	unsigned int i;
+
+	if (!e) {
+		b43err(dev->wl, "AC-PHY: no channel table entry, skipping setup\n");
+		return;
+	}
+
+	/*
+	 * PHY 0x371-0x376 per-canale (set_regtbl_on_chan_change_acphy, path
+	 * radio 2069: phy_reg_write(0x371+i, ci[0x68+2*i]) = entry u16[52..57]).
+	 */
+	for (i = 0; i < 6; i++)
+		b43_phy_write(dev, B43_PHY_AC_BW1A + i, e->phy_bw[i]);
+
+	/* Reset-time register block (includes the CCA reset). */
+	b43_phy_ac_set_reg_on_reset(dev);
+
+	/*
+	 * RXIQ coefficient seed (per-core, 2 bytes each). ch36 #33025-33028.
+	 * Runs before the 2nd AFE/LPF stage call; the comment below mentioned
+	 * these as "not yet ported".
+	 */
+	b43_phy_maskset(dev, 0x02d1, (u16)~0x00f0, 0x0040);
+	b43_phy_maskset(dev, 0x02d1, (u16)~0x0f00, 0x0400);
+	b43_phy_maskset(dev, 0x02d2, (u16)~0x00f0, 0x0040);
+	b43_phy_maskset(dev, 0x02d2, (u16)~0x0f00, 0x0400);
+
+	/*
+	 * Per-core AFE / radio-LPF stage, 2nd call (afe_728 = 0x0000). In the
+	 * down-to-bss-up trace it follows the reset-time block directly, before the
+	 * RF sequencer tables (#51897-51965, ts 1507.099), same helper body as the
+	 * 0x0800 call in op_software_rfkill.
+	 */
+	b43_radio_2069_afe_lpf_stage(dev, 0x0000);
+
+	/* Load the RF sequencer command tables. */
+	b43_phy_ac_rfseq_tbl_init(dev);
+
+	/* ch36 #32889: set bit 8 di 0x0003 dopo il caricamento delle tabelle
+	 * RF sequencer. Significato non confermato (possibile gate/enable
+	 * post-table-load); presente in tutte le catture ch36. */
+	b43_phy_set(dev, 0x0003, 0x0100);
+
+	/* Quiesce silicon RX cores the board doesn't wire (coremask from op_init). */
+	{
+		u8 coremask = dev->phy.ac->coremask;
+		u16 silicon = (u16)((1 << dev->phy.ac->num_cores) - 1);
+
+		if (coremask && coremask != silicon)
+			b43_phy_ac_rxcore_setstate(dev, coremask);
+	}
+}
+
+/*
+ * Coefficient bank (radio_rev 4, 5 GHz): costanti fisse (tbl7 0x2f13/0x00f3, tbl0xc 0x0035, blocco 0x0339-0x0349, 0x0140 maskset), loop per-core gated su coremask, cal-time fuori MVP RX. Trascrizione letterale, forma FIR/notch non confermata.
+ * 4360 agcombo: TODO ; d6220 ch36 @#34803 (fp 9/9) */
+static void b43_phy_ac_coeff_bank_init(struct b43_wldev *dev)
+{
+	static const u16 bank[20] = {	/* 0x0181..0x0194, mask 0x07ff */
+		0x146, 0x088, 0x146, 0x76e, 0x1a8, 0x0a3, 0x0f4, 0x0a3,
+		0x684, 0x0ad, 0x0e5, 0x068, 0x0e5, 0x6be, 0x19e, 0x073,
+		0x0b2, 0x073, 0x5fe, 0x0cc,
+	};
+	unsigned int i;
+
+	b43_phy_write(dev, 0x08a0, 0x0000);
+	b43_phy_write(dev, 0x08a1, 0x0000);
+	b43_phy_mask(dev, B43_PHY_AC_REG_TBL_WRITE_GATE, (u16)~B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+	b43_phy_set(dev, B43_PHY_AC_REG_TBL_WRITE_GATE, B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+	b43_phy_maskset(dev, 0x0076, (u16)~0x0007, 0x0001);
+	b43_phy_set(dev, B43_PHY_AC_CLASSCTL, 0x0800);
+	b43_phy_set(dev, 0x0164, 0x0010);
+
+	b43_phy_maskset(dev, 0x0180, (u16)~0x001f, 0x0015);
+	for (i = 0; i < ARRAY_SIZE(bank); i++)
+		b43_phy_maskset(dev, (u16)(0x0181 + i), (u16)~0x07ff, bank[i]);
+	b43_phy_maskset(dev, 0x01b5, (u16)~0x00ff, 0x0097);
+}
