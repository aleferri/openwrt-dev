+/*
+ * RX-enable: cleanup-side del bracket di cal TX vendor (ch36 #52335-52460),
+ * usato standalone -- unico punto del bring-up col kick force_rfseq(RST2RX)
+ * (#52458). Omessi gli op della cal propria (gain TBL 7/0xc gia' scritti da
+ * adc_reset/txpwr_by_index, write-back coefficienti). Valori AFE = operativi
+ * catturati ch36, ordine di scrittura vendor.
+ */
+static void b43_phy_ac_rx_enable(struct b43_wldev *dev)
+{
+	u8 c;
+
+	/* Arm del bracket di cal (#50141-48). */
+	b43_phy_ac_rx_gate(dev, true);
+
+	for (c = 0; c < dev->phy.ac->num_cores; c++) {
+		u16 s = (u16)(c * 0x0200);
+
+		if (!((dev->phy.ac->coremask >> c) & 1))
+			continue;
+
+		b43_phy_write(dev, 0x073e + s, 0x0000);	/* #52335 / #52426 */
+		b43_phy_write(dev, 0x0678 + s, 0x0008);	/* #52336 / #52427 */
+
+		/* Restore AFE, #52337-52361 (core1: #52428-52452). */
+		b43_phy_write(dev, 0x0720 + s, 0x0180);
+		b43_phy_write(dev, 0x0721 + s, 0x5000);
+		b43_phy_write(dev, 0x0722 + s, 0x0000);
+		b43_phy_write(dev, 0x0723 + s, 0x0000);
+		b43_phy_write(dev, 0x0724 + s, 0x0000);
+		b43_phy_write(dev, 0x0725 + s, 0x0600);
+		b43_phy_write(dev, 0x0727 + s, 0x0004);
+		b43_phy_write(dev, 0x0726 + s, 0x000c);
+		b43_phy_write(dev, 0x0728 + s, 0x0880);
+		b43_phy_write(dev, 0x0729 + s, 0x1000);
+		b43_phy_write(dev, 0x0732 + s, 0x0000);
+		b43_phy_write(dev, 0x0733 + s, 0x0000);
+		b43_phy_write(dev, 0x0730 + s, 0x0000);
+		b43_phy_write(dev, 0x0731 + s, 0x0000);
+		b43_phy_write(dev, 0x0734 + s, 0x0000);
+		b43_phy_write(dev, 0x0735 + s, 0x0000);
+		b43_phy_write(dev, 0x0737 + s, 0x0000);
+		b43_phy_write(dev, 0x0738 + s, 0x0000);
+		b43_phy_write(dev, 0x0736 + s, 0x0000);
+		b43_phy_write(dev, 0x0739 + s, 0x0000);
+		b43_phy_write(dev, 0x073a + s, 0x0180);
+		b43_phy_write(dev, 0x073b + s, 0x002c);
+		b43_phy_write(dev, 0x073c + s, 0x0000);
+		b43_phy_write(dev, 0x073d + s, 0x0000);
+		b43_phy_write(dev, 0x0747 + s, 0x0000);
+	}
+
+	b43_phy_write(dev, 0x040f, 0x09ff);	/* #52453 */
+
+	/* Il kick: #52454-52461, stesso idioma save/gate/trig/poll/restore
+	 * dell'helper (il vendor legge 0x403 una volta sola; noi polliamo). */
+	b43info(dev->wl, "phy-ac: rx-enable RST2RX kick %s\n",
+	       b43_phy_ac_force_rf_sequence(dev, B43_PHY_AC_RF_SEQ_RST2RX,
+					    B43_PHY_AC_RF_SEQ_OVERRIDE_GATE) ?
+	       "ok" : "TIMEOUT");
+
+	/* Release finale = stato operativo del vendor (#52480 + #52485-87,
+	 * poi EN_MAC): 0x140=0x0df6 (OFDM|WAITED, niente CCK a 5 GHz),
+	 * clip det OFF. Nessun ri-arm a runtime. */
+	b43_phy_ac_rx_gate(dev, false);
+}
