+/*
+ * Chanspec band/channel setup tail (subito dopo le BW di
+ * channel_setup): 0x0164/0x030f, le gain reg 0x31c-0x31f, il byte basso
+ * CRS-min-power, l'azzeramento 0x910-0x913 e 0x03a9. Valori reali per
+ * ch36/UNII-1 (le WR/MOD di wl-diag sono reali, solo le read sono fasulle); il
+ * board è 5 GHz-only, quindi il ramo 2.4 GHz non è esercitato.
+ */
+static void b43_phy_ac_chanspec_tail(struct b43_wldev *dev)
+{
+	static const u16 crs_reg[8] = { 0x0324, 0x0330, 0x0321, 0x032d,
+					0x032a, 0x0336, 0x0327, 0x0333 };
+	u16 gain = 0x00bf;
+	unsigned int i;
+
+	if (b43_current_band(dev->wl) != NL80211_BAND_5GHZ)
+		gain = 0x00ff;
+	else if (dev->wl->hw->conf.chandef.width == NL80211_CHAN_WIDTH_80)
+		gain = 0x0100;
+
+	b43_phy_mask(dev, 0x0164, (u16)~0x0010);
+	b43_phy_mask(dev, 0x030f, (u16)~0xc000);
+
+	/* Band/BW gain: 0xbf su 5 GHz, 0x100 su 5 GHz/80 MHz, 0xff su 2.4 GHz. */
+	b43_phy_write(dev, 0x031c, gain);
+	b43_phy_write(dev, 0x031d, gain);
+	b43_phy_write(dev, 0x031e, gain);
+	b43_phy_write(dev, 0x031f, gain);
+
+	/*
+	 * CRS min-power, byte BASSO sugli 8 reg. BW-dipendente:
+	 *   20 MHz â 0x34 (ch36/ch44 d6220, #35056/#81481)
+	 *   40 MHz â 0x36 (ch36-40 d6220, #57810)
+	 *   80 MHz â 0x36 (da cattura precedente, non in repo)
+	 * Il byte alto (0x36, scritto post-cal #38067) e il ricalcolo
+	 * periodico a runtime restano NON portati.
+	 */
+	{
+		u8 crs = 0x34;
+
+		if (dev->wl->hw->conf.chandef.width != NL80211_CHAN_WIDTH_20)
+			crs = 0x36;
+
+		for (i = 0; i < 8; i++)
+			b43_phy_maskset(dev, crs_reg[i], (u16)~0x00ff, crs);
+	}
+
+	/* Azzeramento 0x0910-0x0913, per-byte maskset come da ch36 #35064-35071.
+	 * 0x0910/0x0912: high poi low; 0x0911/0x0913: low poi high. */
+	b43_phy_maskset(dev, 0x0910, (u16)~0xff00, 0x0000);
+	b43_phy_maskset(dev, 0x0910, (u16)~0x00ff, 0x0000);
+	b43_phy_maskset(dev, 0x0912, (u16)~0xff00, 0x0000);
+	b43_phy_maskset(dev, 0x0912, (u16)~0x00ff, 0x0000);
+	b43_phy_maskset(dev, 0x0911, (u16)~0x00ff, 0x0000);
+	b43_phy_maskset(dev, 0x0911, (u16)~0xff00, 0x0000);
+	b43_phy_maskset(dev, 0x0913, (u16)~0x00ff, 0x0000);
+	b43_phy_maskset(dev, 0x0913, (u16)~0xff00, 0x0000);
+
+	b43_phy_mask(dev, 0x03a9, (u16)~0x007f);
+	b43_phy_mask(dev, 0x03a9, (u16)~0x0800);
+}
