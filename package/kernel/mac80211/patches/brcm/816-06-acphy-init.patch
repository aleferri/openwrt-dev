+/*
+ * rx_evm_shaping (table 0x04) per-channel override: due run da 3 byte, width 8 (off 0x01={08,06,04}, off 0x3d={04,06,08}). Non board/SROM-varying, verbatim.
+ * 4360 agcombo #6164-6175 ; d6220 ch36 TBL.WR id=0x04 off 0x01/0x3d @#34894,#34901 */
+static void b43_phy_ac_rx_evm_shaping_override(struct b43_wldev *dev)
+{
+	static const u8 blk_lo[3] = { 0x08, 0x06, 0x04 };
+	static const u8 blk_hi[3] = { 0x04, 0x06, 0x08 };
+	u16 saved;
+
+	saved = b43_phy_ac_tbl_write_lock(dev);
+	b43_actab_write_bulk(dev, 0x04, 0x01, 8, ARRAY_SIZE(blk_lo), blk_lo);
+	b43_actab_write_bulk(dev, 0x04, 0x3d, 8, ARRAY_SIZE(blk_hi), blk_hi);
+	b43_phy_ac_tbl_write_unlock(dev, saved);
+}
