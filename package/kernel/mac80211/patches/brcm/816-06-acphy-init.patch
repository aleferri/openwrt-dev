+/* 4360 agcombo: 5810-6348 ; d6220 ch36: n/l */
+static int b43_phy_ac_set_channel(struct b43_wldev *dev,
+				  struct ieee80211_channel *channel,
+				  enum nl80211_channel_type channel_type)
+{
+	struct b43_phy *phy = &dev->phy;
+	const struct b43_phy_ac_channeltab_e_radio2069 *e2069;
+
+	/* Entry log: bracketa ogni run in dmesg e rende visibili gli early-return
+	 * (txpwr_by_index ha un solo call site: una sua riga "anticipata" puo'
+	 * venire solo da un set_channel precedente). */
+	b43info(dev->wl, "phy-ac: set_channel ch%u (%u MHz) start\n",
+	       channel->hw_value, channel->center_freq);
+
+	if (phy->radio_ver != 0x2069)
+		return -ESRCH;
+
+	if (phy->radio_rev != 4)
+		return -ESRCH;
+
+	e2069 = b43_phy_ac_get_channeltab_e_r2069(dev, channel->center_freq);
+	if (!e2069)
+		return -ESRCH;
+
+	/* PMU regctl 0: clear bit 1 before channel reconfigure. ch36 #32404. */
+	bcma_chipco_regctl_maskset(&dev->dev->bdev->bus->drv_cc,
+				   0, ~0x00000002, 0x00000000);
+
+	/*
+	 * Freeze RX path before channel reconfigure: classifier WAITED-only,
+	 * clip detectors frozen, CCA reset. Trace d6220 ch36 #32891-32901,
+	 * BEFORE radio_channel_setup (#34530). Everything from here through
+	 * rx_enable runs under RX=w CLIP=111; first release is the rx_gate
+	 * pulse in idle_tssi_meas (#38209).
+	 */
+	b43_phy_ac_classifier(dev, 0x0007, B43_PHY_AC_CLASSCTL_WAITEDEN);
+	b43_phy_ac_clip_det(dev, false);
+	b43_phy_ac_reset_cca(dev);
+
+	b43_radio_2069_channel_setup(dev, e2069);
+	b43_phy_ac_channel_setup(dev, e2069, channel);
+	b43_phy_ac_farrow_setup(dev, channel);
+
+	/* Chanspec band/channel setup tail. */
+	b43_phy_ac_chanspec_tail(dev);
+
+	/* 0x1ec non e' band-gated: 0x9c40 = valore channel-time in tutte le catture
+	 * (tutte 5 GHz; ch36 #34559). Il finto ramo 2.4 (0x0002/0x0f00) era la
+	 * coppia init agcombo #27-28. 0x2e4->0x0800 solo sul 4360 (#5810). */
+	b43_phy_write(dev, 0x01ec, 0x9c40);
+	if (dev->dev->chip_id == 0x4360)
+		b43_phy_maskset(dev, 0x02e4, (u16)~0x3f00, 0x0800);
+
+	/*
+	 * Il corpo tabelle-per-canale + calibrazione gira MAC-sospeso: nel trace
+	 * (ch36) è un unico intervallo EN_MAC (mask 0x1) di ~12000 op che copre da
+	 * qui fino a fine calibrazione, non 90 bracket per-op. Il freeze RX
+	 * (classifier/clip_det) è già attivo da prima di radio_channel_setup.
+	 * b43_mac_suspend/enable sono refcounted, quindi eventuali suspend annidati
+	 * nelle cal helper sono innocui.
+	 * NB confine di enable indicativo: da confermare sul trace annotato quando
+	 * rxgainctrl_regs sarà mappato con precisione.
+	 */
+	b43_mac_suspend(dev);
+
+	/* Coeff bank + tabelle per-canale, fra il chanspec
+	 * setup e rxgain_init. Ordine fedele a meno di interleaving disgiunto. */
+	b43_phy_ac_coeff_bank_init(dev);
+	b43_phy_ac_rx_evm_shaping_override(dev);
+	b43_phy_ac_chan_tables(dev);
+
+	/*
+	 * RSSI offset, AGC, RSSI compensation per-core, gain program bits,
+	 * TX power table port writes. ch36 #34833-35020.
+	 * Between chan_tables and rxgain_init — the gain program and RSSI
+	 * offset registers that the RX gain cal (WI-5) will later sweep over.
+	 */
+	{
+		unsigned int core;
+
+		/* RSSI offset + AGC config (ch36 #34833-34850) */
+		b43_phy_maskset(dev, 0x0250, (u16)~0x00ff, 0x0019);
+		b43_phy_maskset(dev, 0x0261, (u16)~0x0fff, 0x0014);
+		b43_phy_maskset(dev, 0x0262, (u16)~0x0fff, 0x00c8);
+		b43_phy_maskset(dev, 0x0263, (u16)~0x0fff, 0x0019);
+		b43_phy_maskset(dev, 0x0312, (u16)~0x00ff, 0x0013);
+		b43_phy_maskset(dev, 0x0313, (u16)~0xff00, 0x1300);
+
+		/* RSSI compensation per-core: 0x06ed/0x06ef + stride (ch36 #34839-34850) */
+		for (core = 0; core < dev->phy.ac->num_cores; core++) {
+			u16 s = (u16)(core * 0x200);
+
+			b43_phy_maskset(dev, 0x06ed + s, (u16)~0x00ff, 0x000a);
+			b43_phy_maskset(dev, 0x06ef + s, (u16)~0x00ff, 0x0017);
+			b43_phy_maskset(dev, 0x06ef + s, (u16)~0xff00, 0x0e00);
+		}
+		for (core = 0; core < dev->phy.ac->num_cores; core++)
+			b43_phy_maskset(dev, 0x06ef + (u16)(core * 0x200),
+					(u16)~0x00ff, 0x000f);
+
+		/* Gain program per-core (ch36 #34910-35008) */
+		for (core = 0; core < dev->phy.ac->num_cores; core++) {
+			u16 s = (u16)(core * 0x200);
+
+			b43_phy_maskset(dev, 0x073a + s, (u16)~0x0080, 0x0080);
+			b43_phy_maskset(dev, 0x0725 + s, (u16)~0x0200, 0x0200);
+		}
+
+		b43_phy_write(dev, 0x0197, 0x0014);
+		b43_phy_write(dev, 0x0198, 0x0010);
+		b43_phy_maskset(dev, 0x0410, (u16)~0x0008, 0x0000);
+		b43_phy_maskset(dev, 0x0410, (u16)~0x0380, 0x0000);
+
+		/* Per-core gain bit-clear (ch36 #34960-35008) */
+		for (core = 0; core < dev->phy.ac->num_cores; core++) {
+			u16 s = (u16)(core * 0x200);
+
+			b43_phy_maskset(dev, 0x073a + s, (u16)~0x0008, 0x0000);
+			b43_phy_maskset(dev, 0x0725 + s, (u16)~0x0040, 0x0000);
+			b43_phy_maskset(dev, 0x073a + s, (u16)~0x0010, 0x0000);
+			b43_phy_maskset(dev, 0x0725 + s, (u16)~0x0080, 0x0000);
+			b43_phy_maskset(dev, 0x073a + s, (u16)~0x0007, 0x0000);
+			b43_phy_maskset(dev, 0x0725 + s, (u16)~0x0020, 0x0000);
+		}
+
+		/* TX power table port writes (ch36 #35009-35020) */
+		b43_phy_write(dev, 0x019a, 0x5555);
+		b43_phy_write(dev, 0x019b, 0x0059);
+		b43_phy_write(dev, 0x019c, 0x0f00);
+		b43_phy_write(dev, 0x0199, 0x00a7);
+		b43_phy_write(dev, 0x01a1, 0x5555);
+		b43_phy_write(dev, 0x01a2, 0x0059);
+		b43_phy_write(dev, 0x01a3, 0x0f00);
+		b43_phy_write(dev, 0x01a0, 0x00a7);
+		b43_phy_write(dev, 0x1603, 0xe356);
+		b43_phy_write(dev, 0x1602, 0x005e);
+		b43_phy_write(dev, 0x1607, 0xe356);
+		b43_phy_write(dev, 0x1606, 0x005e);
+		b43_phy_read_log(dev, 0x0601);	/* ch36 #35019 */
+		b43_phy_write(dev, 0x1601, 0x0049);
+	}
+
+	b43_phy_ac_rxgain_init(dev);
+
+	/*
+	 * Noise shaping per-core (ch36 #37410-37846). Runs between rxgain_init
+	 * and afecal; repeated for each core with per-core stride.
+	 */
+	{
+		unsigned int core;
+
+		for (core = 0; core < dev->phy.ac->num_cores; core++) {
+			u16 s = (u16)(core * 0x200);
+
+			b43_phy_read_log(dev, 0x073e + s);	/* ch36 #37622/#37729/#37836 */
+			b43_phy_write(dev, 0x073e + s, 0x0000);
+			b43_phy_maskset(dev, 0x06f9 + s, (u16)~0x7f00, 0x1600);
+			b43_phy_maskset(dev, 0x06f9 + s, (u16)~0x007f, 0x0002);
+			b43_phy_write(dev, 0x173b, 0x002c);
+		}
+
+		/* ch36 #37410: 0x016c set bit 6 (noise shaping enable) */
+		b43_phy_read_log(dev, 0x016c);
+		b43_phy_set(dev, 0x016c, 0x0040);
+	}
+
+	b43_phy_ac_reset_cca(dev);
+	udelay(1);
+
+	/* BW select per-core (ch36 #38075-38078), right before afecal. */
+	b43_phy_write(dev, 0x0304, 0x4e51);
+	b43_phy_write(dev, 0x0307, 0x4e51);
+	b43_phy_write(dev, 0x030a, 0x4e51);
+	b43_phy_write(dev, 0x030d, 0x4e51);
+
+	{
+		int err = b43_radio_2069_afecal(dev);
+
+		if (err) {
+			b43err(dev->wl, "phy-ac: set_channel aborted — afecal failed\n");
+			b43_mac_enable(dev);
+			return err;
+		}
+	}
+
+	/*
+	 * ADC reset (cal-time): run after afecal and
+	 * before the idle-TSSI capture. Includes the 0x70[15:13] TX-power-
+	 * control enable (mid-block).
+	 */
+	b43_phy_ac_adc_reset(dev);
+
+	/* Idle-TSSI measurement: preamble once + per-active-core body inside. */
+	b43_phy_ac_idle_tssi_meas(dev);
+
+	/*
+	 * Short settle before txpwrctrl reads the idle-TSSI result. The trace
+	 * shows a ~35 ms gap here, but that is idle
+	 * wall-clock in the wl-diag capture, not a mandated settle; a brief
+	 * busy-wait suffices. udelay, not mdelay: µs, not ms.
+	 */
+	udelay(35);
+
+	/* Confini di fase, pulse release+arm come il vendor: idle_tssi esce
+	 * released; arm #41157 -> txpwrctrl; pulse #46073/#46106 tra le due
+	 * fasi txpwr; release #50128 dopo. */
+	b43_phy_ac_rx_gate(dev, true);
+	b43_phy_ac_txpwrctrl_setup(dev, channel->center_freq);
+	b43_phy_ac_rx_gate(dev, false);
+	b43_phy_ac_rx_gate(dev, true);
+	b43_phy_ac_txpwr_by_index(dev, B43_PHY_AC_TXPWR_INDEX);
+	b43_phy_ac_rx_gate(dev, false);
+
+	/*
+	 * RX-IQ estimation (debug): run the 4-tone-mode measurement from the
+	 * ch36 trace (#50526-51118) and log the raw accumulator values. This
+	 * does not compute or apply compensation — only reads what the HW
+	 * reports so we can validate the register-map assumptions.
+	 *
+	 * TODO: once the accumulators are confirmed, replace this with the
+	 * full RXIQ calibration (4-tone sweep → coefficient computation →
+	 * write-back to 0x0720/0x0920 series).
+	 */
+	b43_phy_ac_rxiq_est_debug(dev);
+
+	/* Gain-control RX per-core (0x0720-0x073e): nel vendor sta PRIMA del
+	 * bracket di cal (#62314, ch36-40) e rigira ogni ~10s a runtime
+	 * (#75698/#76279/..., recalc periodico non portato). */
+	b43_phy_ac_rxgainctrl_regs(dev);
+
+	/* RX-enable (kick RST2RX): ultima attivita' PHY della finestra
+	 * MAC-sospesa, come il vendor (kick2 #75458 < EN_MAC #75543;
+	 * in ch36: #52458 < #52543). */
+	b43_phy_ac_rx_enable(dev);
+
+	b43_mac_enable(dev);
+
+	return 0;
+}
+
+/*
+ * PHY attach/init entry (.init op). Whole-attach dispatcher: each step below
+ * carries its own capture range on its own function. First op on the wire is
+ * the num_cores read (4360 #5); the trailing PMU regctl/GPIO
+ * pair is 4360 #335-336.
+ */
+static int b43_phy_ac_op_init(struct b43_wldev *dev)
+{
+	if (dev->dev->bus_type != B43_BUS_BCMA) {
+		b43err(dev->wl, "AC-PHY is supported only on BCMA bus!\n");
+		return -EOPNOTSUPP;
+	}
+
+	/* Only the 0x4352/0x4360 chips are supported. */
+	if (dev->dev->chip_id != 0x4352 && dev->dev->chip_id != 0x4360) {
+		b43err(dev->wl,
+		       "AC-PHY: chip 0x%04x not in the implemented acphychipid dispatch {0x4352,0x4360}\n",
+		       dev->dev->chip_id);
+		return -EOPNOTSUPP;
+	}
+
+	/*
+	 * Raw RF-chain count, log it, then clamp to the 3-chain array max.
+	 * Read of 0x000b: 4360 #5 (faked in wl-diag; our first-run
+	 * capture on the DSL-3580L reads it back as num_cores=3, coremask=3).
+	 */
+	dev->phy.ac->num_cores = b43_phy_read(dev, 0x000b) & 0x07;
+	b43info(dev->wl, "phy-ac: num_cores raw = %u\n", dev->phy.ac->num_cores);
+	dev->phy.ac->num_cores = min_t(u8, dev->phy.ac->num_cores, 3);
+
+	/*
+	 * Which of those chains are actually populated. num_cores is only the
+	 * slot count (e.g. 3 on a 2x2 part); touching the radio/PHY space of an
+	 * unpopulated, powered-down core hangs the backplane. Gate every
+	 * per-core register loop on this mask. Fall back to all cores when the
+	 * SROM leaves rxchain unset.
+	 */
+	dev->phy.ac->coremask = dev->dev->bus_sprom->rxchain & 0x07;
+	if (!dev->phy.ac->coremask)
+		dev->phy.ac->coremask = 3;
+
+	b43info(dev->wl, "phy-ac: coremask = 0x%x\n", dev->phy.ac->coremask);
+
+	b43_phy_ac_mode_init(dev);
+
+	/*
+	 * PMU regctl chip-dependent field [24:20] (0x1 on 4352, 0x2 on 4360) +
+	 * GPIO.CTL clear. agcombo 4360 #335-336, at the tail of the
+	 * mode_init window. GPIO is 4360-only evidence (the 4352 capture does not
+	 * hook it), left chip-common. The PLLCTL2/3 writes and the regctl 0x2
+	 * strobe from this window live in bcma_pmu_{pll,resources}_init.
+	 */
+	bcma_chipco_regctl_maskset(&dev->dev->bdev->bus->drv_cc, 0, ~0x01f00000,
+				   dev->dev->chip_id == 0x4360 ? 0x200000 : 0x100000);
+	bcma_chipco_gpio_control(&dev->dev->bdev->bus->drv_cc, 0xffff, 0);
+
+	b43_phy_ac_tables_init(dev);
+
+	/* Band/chip-agnostic PHY register writes (agcombo 4360 #4071-4086). */
+	b43_phy_ac_init_regs(dev);
+
+	/*
+	 * Coeff bank + twin 0x00ec..0x00f5 sono channel-time, non op_init:
+	 * stanno in coeff_bank_init/chan_tables, chiamati da set_channel.
+	 */
+
+	return 0;
+}
+
+/* enable path: down-to-bss-up #86587-86616 ; 4360 agcombo: 16-354 ; d6220 ch36: n/l come funzione (le sub-chiamate radio/init/channel_setup sono localizzate singolarmente) */
+static void b43_phy_ac_op_software_rfkill(struct b43_wldev *dev, bool blocked)
+{
+	if (dev->dev->chip_id != 0x4352 && dev->dev->chip_id != 0x4360)
+		return;
+
+	if (dev->phy.ac->num_cores == 0 || dev->phy.ac->coremask == 0) {
+		dev->phy.ac->num_cores = b43_phy_read(dev, 0x000b) & 0x07;
+		b43info(dev->wl, "phy-ac: num_cores = %u\n", dev->phy.ac->num_cores);
+		dev->phy.ac->num_cores = min_t(u8, dev->phy.ac->num_cores, 3);
+
+		dev->phy.ac->coremask = dev->dev->bus_sprom->rxchain & 0x07;
+		if (!dev->phy.ac->coremask) {
+			dev->phy.ac->coremask = 3;
+		}
+		b43info(dev->wl, "phy-ac: coremask = %u\n", dev->phy.ac->coremask);
+	}
+
+	if (blocked) {
+		/*
+		 * Radio OFF. Return the 0x17xx front-end to the down state the
+		 * OEM leaves it in while going down, the tail of
+		 * the same block b43_phy_ac_mode_init applies at init. NOTE:
+		 * reuses that down-state tail, not a dedicated runtime rfkill-block
+		 * capture; the power-on enable sequence is in the unblocked branch
+		 * (see below).
+		 */
+		b43_phy_write(dev, 0x1728, 0x0080);
+		b43_phy_write(dev, 0x1720, 0x0180);
+		b43_phy_write(dev, 0x1729, 0x0000);
+		b43_phy_write(dev, 0x1721, 0x5000);
+		return;
+	}
+
+	if (dev->phy.radio_ver != 0x2069) {
+		B43_WARN_ON(1);
+		return;
+	}
+
+	b43_radio_2069_init(dev);
+	b43_radio_2069_pwron(dev);
+	b43_radio_2069_rccal(dev);
+
+	/*
+	 * Per-core AFE / radio-LPF stage. Runs right after RC-cal in the radio
+	 * bring-up (#51609-51677, after the 0x08ea RCCAL_EN cleanup, before the
+	 * op_init analog reset). afe_728 = 0x0800 in the ch36/5GHz capture.
+	 */
+	b43_radio_2069_afe_lpf_stage(dev, 0x0800);
+
+	/* GPIO frontend a due fasi in entrambe le catture: bring-up pin2 alto/pin10
+	 * basso (ch36 #52545-46), a regime col blocco PA l'inverso (#55139-40 /
+	 * #86593-94). Semantica pin non confermata; OE non in trace d6220. */
+	bcma_chipco_gpio_outen(&dev->dev->bdev->bus->drv_cc,
+			       0x0404, 0x0404);		/* not in d6220 trace */
+	bcma_chipco_gpio_out(&dev->dev->bdev->bus->drv_cc,
+			     0x0404, 0x0004);		/* fase 1: #52545-46 */
+
+	/* PA bias/tx-gain per-core: operating-point RICALCOLATI per-run (ch36
+	 * #55111-16 ha valori leggermente diversi da questi, presi da dtbu
+	 * #86566-92); hardcode = snapshot. Core diversi, non specchiare. */
+	b43_radio_write(dev, 0x0002, 0x0078);		/* #86566 */
+	b43_radio_write(dev, 0x0003, 0x0078);		/* #86567 */
+	b43_radio_write(dev, 0x0004, 0x0069);		/* #86568 */
+	b43_radio_write(dev, 0x0005, 0x0078);		/* #86569 */
+	b43_phy_write(dev, 0x06a0, 0x03f2);		/* #86570 */
+	b43_phy_write(dev, 0x06a1, 0x0054);		/* #86571 */
+
+	b43_radio_write(dev, 0x0202, 0x0088);		/* #86587 */
+	b43_radio_write(dev, 0x0203, 0x0087);		/* #86588 */
+	b43_radio_write(dev, 0x0204, 0x0088);		/* #86589 */
+	b43_radio_write(dev, 0x0205, 0x0078);		/* #86590 */
+	b43_phy_write(dev, 0x08a0, 0x03da);		/* #86591 */
+	b43_phy_write(dev, 0x08a1, 0x003c);		/* #86592 */
+	bcma_chipco_gpio_out(&dev->dev->bdev->bus->drv_cc,
+			     0x0404, 0x0400);		/* fase 2: #55139-40 / #86593-94 */
+
+	/*
+	 * Radio ON: arm the RF front-end switch. This is the final step of the
+	 * bss-up bring-up in the OEM trace (#86603-86616, D6220/BCM4352).
+ * Sull'agcombo lo stesso blocco gira anche a inizio attach (#16-28) con in
+	 * piu' 0x2e4->0x0f00 / 0x1ec=0x0002; witness 4352 (#86603-16) senza, e
+	 * nessuna cattura d6220 copre l'inizio attach.
+	 */
+	b43_phy_write(dev, 0x173e, 0x0000);
+	b43_phy_write(dev, 0x1739, 0x0000);
+	b43_phy_write(dev, 0x173a, 0x0000);
+	b43_phy_write(dev, 0x1725, 0x1fff);
+	b43_phy_write(dev, 0x1729, 0x0000);
+	b43_phy_write(dev, 0x1721, 0xffff);
+	b43_phy_write(dev, 0x1728, 0x0000);
+	b43_phy_write(dev, 0x1720, 0x03ff);
+	b43_phy_mask(dev, 0x0408, (u16)~0x0002);	/* #86611: clear bit, not full 0 */
+	b43_phy_write(dev, 0x0417, 0x0000);
+	b43_phy_write(dev, 0x0416, 0x0001);
+
+	/* #86616: final PMU regcontrol enable (reg0 |= 0x2). */
+	bcma_chipco_regctl_maskset(&dev->dev->bdev->bus->drv_cc, 0,
+				   ~0x00000002u, 0x00000002u);
+}
+
+static int b43_phy_ac_op_switch_channel(struct b43_wldev *dev,
+					unsigned int new_channel)
+{
+	struct ieee80211_channel *channel = dev->wl->hw->conf.chandef.chan;
+	enum nl80211_channel_type channel_type =
+		cfg80211_get_chandef_type(&dev->wl->hw->conf.chandef);
+
+	if (b43_current_band(dev->wl) == NL80211_BAND_2GHZ) {
+		b43info(dev->wl,
+		       "AC-PHY: 2.4 GHz channel %u not supported on this board\n",
+		       new_channel);
+		return -EOPNOTSUPP;
+	}
+
+	/* 5 GHz: the channel table is the filter (unknown channels -ESRCH). */
+	return b43_phy_ac_set_channel(dev, channel, channel_type);
+}
+
+/* R/W ops */
+
+/* Plain PHY register read/write. */
+static u16 b43_phy_ac_op_read(struct b43_wldev *dev, u16 reg)
+{
+	if (B43_WARN_ON(reg == 0xFFFF))
+		return 0;
+	b43_write16f(dev, B43_MMIO_PHY_CONTROL, reg);
+	return b43_read16(dev, B43_MMIO_PHY_DATA);
+}
+
+static void b43_phy_ac_op_write(struct b43_wldev *dev, u16 reg, u16 value)
+{
+	if (B43_WARN_ON(reg == 0xFFFF))
+		return;
+	b43_write16f(dev, B43_MMIO_PHY_CONTROL, reg);
+	b43_write16(dev, B43_MMIO_PHY_DATA, value);
+}
