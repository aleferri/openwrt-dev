diff --git a/drivers/net/wireless/broadcom/b43/rxgain_phy_ac.c b/drivers/net/wireless/broadcom/b43/rxgain_phy_ac.c
new file mode 100644
index 000000000..5f69132d5
--- /dev/null
+++ b/drivers/net/wireless/broadcom/b43/rxgain_phy_ac.c
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "b43.h"
+#include "phy_ac.h"
+#include "rxgain_phy_ac.h"
+#include "tables_phy_ac.h"
+
+/* Per-core phy_reg_write sequence (default chipid) */
+
+struct b43_phy_ac_rxgain_chip_write {
+	u16 reg;
+	u16 val;
+};
+
+/*
+ * Le due chip-write (0x173b=44, 0x1726=12) girano su ogni core, non core-strided.
+ * 4360 agcombo #8370-8371 ; d6220 ch36 @#37632,#37739,#37846 (0x173b=0x2c, 0x1726=0x0c per core) */
+static const struct b43_phy_ac_rxgain_chip_write
+b43_phy_ac_rxgain_chip_writes_default[2] = {
+	{ 0x173b, 44 },
+	{ 0x1726, 12 },
+};
+
+/*
+ * Tables 0x44/0x45, 5gl: tre blocchi per core - 0x44 off 0 (2, eLNA header SROM = (elnagain+3)<<1), 0x44 off 32 (10, cost 0x07), 0x45 off 32 (10, cost 0x02). Off 8/16 sono channel-tuning (scritte da chan_tables).
+ * 4360 agcombo #8366-8397 ; d6220 ch36 TBL.WR id=0x44 off 0/0x20, id=0x45 off 0x20 */
+static void
+b43_phy_ac_rxgain_table_writes(struct b43_wldev *dev,
+			       const struct ssb_sprom_rxgains *rxgains,
+			       unsigned int core)
+{
+	u8 hdr = (u8)((rxgains->elnagain[core] + 3) << 1);
+	u8 hdr_blk[2] = { hdr, hdr };
+	static const u8 tbl44_off32[10] = {
+		0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07,
+	};
+	static const u8 tbl45_off32[10] = {
+		0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
+	};
+
+	b43_actab_write_bulk(dev, 0x44,  0, 8,  2, hdr_blk);
+	b43_actab_write_bulk(dev, 0x44, 32, 8, 10, tbl44_off32);
+	b43_actab_write_bulk(dev, 0x45, 32, 8, 10, tbl45_off32);
+}
+
+/*
+ * Analog RX gain stages (5gl, 20 MHz, triso=6, ext-LNA present) — captured
+ * directly from la trace,  (core 0).
+ *
+ * Stage order follows the wire: 0x6e4 is written before 0x6e2 (both carry the
+ * same value, so end-state is order-independent, but the sequence matches the
+ * trace). The single access to 0x6e1 in the whole capture is stage 2's
+ * companion ; nothing else touches it in 15067 lines.
+ *
+ * TODO: only 5gl/triso=6/ext_lna=1 is covered. A second data point is needed
+ * to split the fixed marker bit from any real per-code companion field before
+ * this can be generalised into a formula again.
+ */
+struct b43_phy_ac_rxgain_stage {
+	u16 reg;	/* offset, +core*0x200 applied by the caller */
+	u16 word;	/* captured value for reg */
+	u16 companion;	/* captured value for reg+1 */
+};
+
+static const struct b43_phy_ac_rxgain_stage b43_phy_ac_rxgain_stages_5gl[5] = {
+	{ 0x6dc, 0x016a, 0x0604 },
+	{ 0x6de, 0x015a, 0x0004 },
+	{ 0x6e0, 0x016a, 0x0018 },
+	{ 0x6e4, 0x013a, 0x0008 },	/* written before 0x6e2 on the wire */
+	{ 0x6e2, 0x013a, 0x0008 },
+};
+
+/*
+ * One analog gain-stage register pair, with the gate toggles the blob emits
+ * around it (per core):
+ *
+ *  - stage 0 carries a companion table-7 write; the table-write gate
+ *    (0x019e[1]) is raised only around that access and dropped again, so the
+ *    analog register pair itself is written with the gate low;
+ *  - stages 1-4 strobe the per-core gain-bank gate (0x?e3[1]) low before each
+ *    register pair.
+ */
+static void b43_phy_ac_set_analog_rxgain(struct b43_wldev *dev, u8 stage,
+					 unsigned int core)
+{
+	const struct b43_phy_ac_rxgain_stage *s =
+		&b43_phy_ac_rxgain_stages_5gl[stage];
+	u16 stride = (u16)(core * 0x200);
+	u16 greg = stride + s->reg;
+
+	if (stage == 0) {
+		u16 t7 = 0xc0b5;
+
+		b43_phy_write(dev, greg, s->word);
+		b43_phy_write(dev, greg + 1, s->companion);
+		b43_phy_set(dev, B43_PHY_AC_REG_TBL_WRITE_GATE, B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+		b43_actab_write_bulk(dev, 7, 0xf9 + core, 16, 1, &t7);
+		b43_phy_mask(dev, B43_PHY_AC_REG_TBL_WRITE_GATE, (u16)~B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+	} else {
+		b43_phy_mask(dev, stride + 0x06e3, (u16)~0x0002);
+		b43_phy_write(dev, greg, s->word);
+		b43_phy_write(dev, greg + 1, s->companion);
+	}
+}
+
+/*
+ * Per-core tail after the analog stages ( for core 0, strided by
+ * 0x200): two PHY field-sets on 0x?ee bracketing radio-side writes to 0x?45 and
+ * 0x?33.
+ */
+static void b43_phy_ac_rxgain_stage_tail(struct b43_wldev *dev, unsigned int core)
+{
+	u16 stride = (u16)(core * 0x200);
+
+	b43_phy_maskset(dev,   stride + 0x06ee, (u16)~0x0003, 0x0001);
+	b43_radio_maskset(dev, stride + 0x0045, (u16)~0x0300, 0x0300);
+	b43_phy_maskset(dev,   stride + 0x06ee, (u16)~0x000c, 0x0008);
+	b43_radio_maskset(dev, stride + 0x0033, (u16)~0x00f0, 0x0080);
+}
+
+/*
+ * RX gain-control bring-up: drop the table-write gate once, then for
+ * every powered core program the 5 analog gain-stage register pairs with their
+ * gate strobes, the trailing gate strobe, and the radio-side
+ * stage tail.
+ *
+ * All num_cores silicon cores are still powered here -- rxcore_setstate masks
+ * the active RX chains, it does not power a core down -- and the blob programs
+ * every core (trace touches core 2), so gate on presence,
+ * not on the antenna/active-chain mask.
+ */
+static void b43_phy_ac_rxgainctrl(struct b43_wldev *dev)
+{
+	unsigned int core;
+	u8 stage;
+
+	b43_phy_mask(dev, B43_PHY_AC_REG_TBL_WRITE_GATE, (u16)~B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+
+	for (core = 0; core < dev->phy.ac->num_cores; core++) {
+		for (stage = 0; stage < ARRAY_SIZE(b43_phy_ac_rxgain_stages_5gl); stage++)
+			b43_phy_ac_set_analog_rxgain(dev, stage, core);
+
+		b43_phy_mask(dev, (u16)(core * 0x200) + 0x06e3, (u16)~0x0002);
+		b43_phy_ac_rxgain_stage_tail(dev, core);
+	}
+}
+
+/* RX gain init */
+
+#define RXGAIN_RFCTL_GATE_BIT	0x0002
+
+/* 4360 agcombo: 8363-8560 ; d6220 ch36: op presenti @#37632,#37739,#37846 (via chip-write per core), funzione non fingerprintata */
+void b43_phy_ac_rxgain_init(struct b43_wldev *dev)
+{
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	const struct ssb_sprom_rxgains *rxgains;
+	u16 saved_tblwr, saved_rfctl;
+	unsigned int core;
+	size_t i;
+
+	saved_tblwr = b43_phy_ac_tbl_write_lock(dev);
+	saved_rfctl = b43_phy_read_log(dev, B43_PHY_AC_RFCTL1);
+	b43_phy_set(dev, B43_PHY_AC_RFCTL1, RXGAIN_RFCTL_GATE_BIT);
+
+	rxgains = &sprom->rxgains_5gl;
+
+	for (core = 0; core < dev->phy.ac->num_cores; core++) {
+		u8 triso = rxgains->triso[core];
+		/* wl7 adds an unconditional +2 (addiu at 0xa20fc): (triso+4)<<1 + 2. */
+		u16 gainctx = (u16)(((triso + 4) << 1) + 2);
+		u16 greg = (u16)(0x6f9 + core * 0x200);
+		u16 lna1_idx;
+
+		/* Read LNA1 gain index from the rxgain table that chan_tables
+		 * populated. The vendor reads tbl 0x45[0x20] per-core and uses
+		 * bits 6:0 of the gain ctx register. On d6220 both channels
+		 * read 0x0002; reading makes it channel/board-independent. */
+		b43_actab_read_bulk(dev, (u16)(0x45 + core * 0x20),
+				    0x20, 16, 1, &lna1_idx);
+
+		b43_phy_maskset(dev, greg, (u16)~0x7f00, (u16)(gainctx << 8));
+		b43_phy_maskset(dev, greg, (u16)~0x007f, lna1_idx & 0x007f);
+
+		for (i = 0; i < ARRAY_SIZE(b43_phy_ac_rxgain_chip_writes_default); i++) {
+			const struct b43_phy_ac_rxgain_chip_write *w =
+				&b43_phy_ac_rxgain_chip_writes_default[i];
+
+			b43_phy_write(dev, w->reg, w->val);
+		}
+
+		b43_phy_ac_rxgain_table_writes(dev, rxgains, core);
+	}
+
+	b43_phy_ac_rxgainctrl(dev);
+
+	b43_phy_write(dev, B43_PHY_AC_RFCTL1, 364);
+	b43_phy_maskset(dev, B43_PHY_AC_RFCTL1,
+			(u16)~RXGAIN_RFCTL_GATE_BIT,
+			saved_rfctl & RXGAIN_RFCTL_GATE_BIT);
+
+	b43_phy_ac_tbl_write_unlock(dev, saved_tblwr);
+
+	b43info(dev->wl,
+	       "phy-ac: rxgain_init run (%u cores, UNII-1 5gl, sprom rev %u)\n",
+	       (unsigned int)dev->phy.ac->num_cores,
+	       (unsigned int)sprom->revision);
+}
