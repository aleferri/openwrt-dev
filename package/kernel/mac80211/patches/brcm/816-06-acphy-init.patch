+/*
+ * Per-channel table loads (radio_rev 4, 5 GHz): twin coeff 0x00ec-0x00f5 + tbl 0x11 (464w) + tbl 0x0b/0x15 + coppia per-core 0x44/0x45 (broadcast a num_cores).
+ * 4360 agcombo: TODO ; d6220 ch36 TBL.WR id=0x11(464w)/0x0b/0x15/0x44/0x45 @#35087+ */
+static void b43_phy_ac_chan_tables(struct b43_wldev *dev)
+{
+	static const u16 twin[10] = {	/* 0x00ec..0x00f5, assolute */
+		0xb54, 0x290, 0x004, 0xa40, 0x290, 0x005, 0xa06, 0x240,
+		0x005, 0x080,
+	};
+	static const u16 t0b_a[6] = { 0x0b, 0x0c, 0x0e, 0x20, 0x24, 0x28 };
+	static const u16 t0b_b[7] = { 0, 0, 0, 3, 3, 3, 3 };
+	static const u16 t15[5]   = { 0x20, 0x21, 0x22, 0x23, 0x24 };
+	static const u16 t44_a[6] = { 0xf9, 0xfe, 0x04, 0x0a, 0x10, 0x17 };
+	static const u16 t44_b[7] = { 0xf5, 0xf8, 0xfb, 0xfe, 0x02, 0x05, 0x09 };
+	static const u16 t45_a[6] = { 0, 1, 2, 3, 4, 5 };
+	static const u16 t45_b[7] = { 0, 1, 2, 3, 4, 5, 6 };
+	u8 num_cores = dev->phy.ac->num_cores;
+	unsigned int i;
+	u16 saved, id;
+	u8 c;
+
+	for (i = 0; i < ARRAY_SIZE(twin); i++)
+		b43_phy_write(dev, (u16)(0x00ec + i), twin[i]);
+
+	saved = b43_phy_ac_tbl_write_lock(dev);
+	b43_actab_write_r11(dev, 0x11, 0, ARRAY_SIZE(b43_acphy_tbl11), b43_acphy_tbl11);
+	b43_actab_write_bulk(dev, 0x0b,  8, 16, ARRAY_SIZE(t0b_a), t0b_a);
+	b43_actab_write_bulk(dev, 0x0b, 16, 16, ARRAY_SIZE(t0b_b), t0b_b);
+	b43_actab_write_bulk(dev, 0x15,  8, 16, ARRAY_SIZE(t15), t15);
+	b43_actab_write_bulk(dev, 0x15, 32, 16, ARRAY_SIZE(t15), t15);
+	b43_actab_write_bulk(dev, 0x15, 56, 16, ARRAY_SIZE(t15), t15);
+	/*
+	 * Broadcast a tutti gli slot silicio (num_cores), non ai soli core attivi:
+	 * la trace 2x2 d6220 scrive anche ID 0x84/0x85 = core 2 (num_cores, non coremask).
+	 */
+	for (c = 0; c < num_cores; c++) {
+		id = (u16)(0x44 + c * 0x20);
+		b43_actab_write_bulk(dev, id,       8, 16, ARRAY_SIZE(t44_a), t44_a);
+		b43_actab_write_bulk(dev, id,      16, 16, ARRAY_SIZE(t44_b), t44_b);
+		b43_actab_write_bulk(dev, (u16)(id + 1),  8, 16, ARRAY_SIZE(t45_a), t45_a);
+		b43_actab_write_bulk(dev, (u16)(id + 1), 16, 16, ARRAY_SIZE(t45_b), t45_b);
+	}
+	b43_phy_ac_tbl_write_unlock(dev, saved);
+}
